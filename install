#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"

log_step() {
  printf '\n==> %s\n' "$*"
}

log_info() {
  printf '  - %s\n' "$*"
}

log_error() {
  printf '  x %s\n' "$*" >&2
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

print_help_without_bun() {
  cat <<'EOF'
Usage: ./install [command] [options]

Commands:
  install, apply      Run the full install or re-apply path (default)
  check, doctor      Show detected platform, profile, and planned steps
  link               Re-link managed files from home/ into $HOME
  secrets            Sync 1Password Environment secrets only
  skills             Sync macOS agent skills only
  macos-defaults     Apply macOS defaults only
  help               Show this help

Options:
  --profile <name>              personal|worker
  --platform <name>             auto|macos|ubuntu|linux|windows
  --1password-environment <id>  Override DOTFILES_1PASSWORD_ENVIRONMENT
  --dry-run                    Print planned actions without applying them
  --help                       Show this help

EOF
}

ensure_bun() {
  if command_exists bun; then
    return
  fi

  if [ -x "$BUN_INSTALL/bin/bun" ]; then
    export PATH="$BUN_INSTALL/bin:$PATH"
    return
  fi

  if ! command_exists curl; then
    log_error "Bun is required to run the installer and curl is required to install Bun."
    exit 1
  fi

  log_step "Installing Bun runtime"
  curl -fsSL https://bun.sh/install | bash
  export PATH="$BUN_INSTALL/bin:$PATH"

  if ! command_exists bun; then
    log_error "Bun was installed but is not available in this shell."
    exit 1
  fi
}

case "${1:-}" in
  -h|--help|help)
    if ! command_exists bun && [ ! -x "$BUN_INSTALL/bin/bun" ]; then
      print_help_without_bun
      exit 0
    fi
    ;;
esac

ensure_bun
exec bun run "$REPO_ROOT/src/install.ts" "$@"
