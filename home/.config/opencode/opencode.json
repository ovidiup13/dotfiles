{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": [
        "uvx",
        "basic-memory",
        "mcp"
      ]
    },
    "homeassistant": {
      "type": "remote",
      "url": "{env:HA_MCP_WEBHOOK_URL}"
    }
  }
}
